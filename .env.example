# Copy this file to .env.local and fill in your real Supabase project values.
# Find both on your Supabase project dashboard: Settings -> API.
# .env.local is already git-ignored — never commit real keys.

# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_URL=

# The "anon" / "public" key — this is safe to expose in client-side code.
# Do NOT use the "service_role" secret key here or anywhere in this app.
VITE_SUPABASE_ANON_KEY=
